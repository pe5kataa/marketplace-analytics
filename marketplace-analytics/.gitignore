# ---- data ------------------------------------------------------------
# Raw CSVs are public, immutable and ~120 MiB (one file is 58 MiB).
# Gold parquet is a build artifact — `dbt build` regenerates it.
# scripts/get_data.py refetches raw and creates these folders.
data/

# ---- dbt -------------------------------------------------------------
target/
dbt_packages/
logs/
.user.yml

# ---- duckdb ----------------------------------------------------------
*.duckdb
*.duckdb.wal

# ---- python ----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]

# ---- power bi --------------------------------------------------------
# Using .pbip (text format), so the project folder IS committed.
# These are the local caches it drops alongside it:
.pbi/
*.pbix
*.Cache
TempSaves/

# ---- os / editor -----------------------------------------------------
Thumbs.db
.DS_Store
.vscode/
.idea/
